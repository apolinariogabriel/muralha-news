# ─────────────────────────────────────────────────────────────
# CONFIGURAÇÕES DO MONITOR DE NOTÍCIAS
# ─────────────────────────────────────────────────────────────
#
# INSTRUÇÕES:
# 1. Copie este arquivo e renomeie para ".env"
# 2. Preencha os valores abaixo com seus dados reais
# 3. NUNCA suba o arquivo ".env" para o GitHub (ele já está no .gitignore)
#
# ─────────────────────────────────────────────────────────────

# E-mail que VAI ENVIAR as notícias (sua conta Gmail)
EMAIL_REMETENTE=seu_email@gmail.com

# Senha de App do Gmail (NÃO é sua senha normal!)
# Como gerar: https://myaccount.google.com/apppasswords
# Passo a passo no README.md
SENHA_APP=xxxx xxxx xxxx xxxx

# E-mail que VAI RECEBER as notícias
EMAIL_DESTINO=limacase9@gmail.com
